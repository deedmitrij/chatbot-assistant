# Telegram Configuration
TG_BOT_TOKEN=your_telegram_bot_token
TG_ADMIN_ID=your_telegram_user_id

# Hugging Face Configuration (embeddings + RAGAS evaluation only)
HF_API_TOKEN=your_huggingface_access_token
HF_BASE_URL=https://router.huggingface.co/v1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Chat Configuration (Assistant + Judge)
# Any OpenAI-compatible endpoint works here. Examples:
#   Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1 | LLM_API_KEY=ollama | CHAT_MODEL=qwen2.5-coder:7b
#   HF router:     LLM_BASE_URL=https://router.huggingface.co/v1 | LLM_API_KEY=your_huggingface_access_token | CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct:featherless-ai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
CHAT_MODEL=qwen2.5:7b

# Vector Database and Handover Logic
VECTOR_SIMILARITY_THRESHOLD=1.2

# Optional: Relational Database Configuration (For Stateless/Containerized Setup)
# DB_PATH=pending_requests.db

# Optional: ChromaDB Server Mode Configuration (For Docker Compose)
# CHROMA_HOST=
# CHROMA_PORT=8000
