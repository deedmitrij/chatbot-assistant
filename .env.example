# Telegram Configuration
TG_BOT_TOKEN=your_telegram_bot_token
TG_ADMIN_ID=your_telegram_user_id

# Hugging Face Configuration
HF_API_TOKEN=your_huggingface_access_token
HF_BASE_URL=https://router.huggingface.co/v1

# Model Selection
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Database and Handover Logic
VECTOR_SIMILARITY_THRESHOLD=1.2

# Optional: Relational Database Configuration (For Stateless/Containerized Setup)
# DB_PATH=pending_requests.db

# Optional: ChromaDB Server Mode Configuration (For Docker Compose)
# CHROMA_HOST=
# CHROMA_PORT=8000
